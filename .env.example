# GEMINI_API_KEY: Required for Gemini AI API calls if AI modules are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL where this applet is hosted (injected in Cloud Run / AI Studio).
# Used to derive OAuth callback URLs (${APP_URL}/api/integrations/google/oauth/callback).
APP_URL="MY_APP_URL"

# SESSION_SECRET: Cryptographic HMAC secret (32+ random bytes) for signing HttpOnly session cookies & SSE tickets.
# Strongly recommended in production.
SESSION_SECRET=""

# INTEGRATION_ENCRYPTION_KEY: 32-byte hex/base64 key or high-entropy passphrase for AES-256-GCM encryption
# of Google Search Console / GA4 OAuth refresh & access tokens stored in SQLite.
INTEGRATION_ENCRYPTION_KEY=""

# Google OAuth 2.0 credentials for Google Search Console & Google Analytics 4 connectors
# Authorized redirect URIs must include:
#   ${APP_URL}/api/integrations/google/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Optional Google PageSpeed Insights API key for higher URL diagnostics quota
PAGESPEED_API_KEY=""

# SQLite storage path (defaults to ./.rovix-data/rovix.sqlite)
ROVIX_DB_PATH=""

# Explicit development safeguards (must NEVER be enabled in live customer production)
ALLOW_DEV_ACCOUNTS="true"
ALLOW_SANDBOX_FIXTURES="true"
